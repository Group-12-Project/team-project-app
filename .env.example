# Local development only. Replace placeholders in your private .env.
MYSQL_DATABASE=gradplanner
MYSQL_USER=gradpath
MYSQL_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LOCAL_PASSWORD
MYSQL_PORT=3307
# URL-encode special characters in the password portion of DATABASE_URL.
DATABASE_URL=mysql://gradpath:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/gradplanner
PORT=3001
