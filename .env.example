# Copy into .env and replace with URLs from your Prisma Console database Connect panel.
# Use standard PostgreSQL URLs, not prisma+postgres:// URLs.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
PORT=3001
# Fictional demo identity only; local production mode always disables this route.
ENABLE_DEMO_PROFILE_API=true
